# Cloud-Edge Task Offloading Optimization Backend Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Allowed CORS origins for Next.js frontend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Offloading nodes (backend/node). Leave a URL empty to keep that tier simulated.
# Edge: the PC on the same Wi-Fi running `python -m node.run`, e.g. http://192.168.1.20:8100
EDGE_NODE_URL=
# Cloud: the deployed node, e.g. https://<user>-<space>.hf.space
CLOUD_NODE_URL=
# Access keys: must match the NODE_TOKEN set on that node (leave empty if the node has none).
EDGE_NODE_TOKEN=
CLOUD_NODE_TOKEN=

# Allow POST /api/optimization/train (it overwrites the trained checkpoint). Off by default.
ENABLE_TRAINING_API=

# DQN Hyperparameters & Reproducibility
DQN_SEED=42
DQN_EPISODES=200
DQN_LEARNING_RATE=0.0005
DQN_GAMMA=0.95
DQN_EPSILON_START=1.0
DQN_EPSILON_END=0.05
DQN_EPSILON_DECAY=0.99
DQN_BATCH_SIZE=64
DQN_TARGET_UPDATE_FREQUENCY=20
DQN_REPLAY_CAPACITY=10000
DQN_MODEL_PATH=app/ml/checkpoints/dqn_offloading_best.pt

# Multi-Objective Reward Weights (Sum = 1.0)
REWARD_WEIGHT_LATENCY=0.35
REWARD_WEIGHT_ENERGY=0.25
REWARD_WEIGHT_COST=0.15
REWARD_WEIGHT_QUEUE=0.10
REWARD_WEIGHT_DEADLINE=0.15

